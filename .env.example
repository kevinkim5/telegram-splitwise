# Telegram Bot Token — get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# The public URL of your Vercel deployment (used to build web_app button URLs)
WEBAPP_URL=https://your-project.vercel.app

# Telegram Bot username (without @) — shown on the landing page deep link
BOT_USERNAME=kevin_tele_splitwise_bot

# Telegram Mini App link — from BotFather /newapp (enables group chat button)
# Format: https://t.me/YOUR_BOT_USERNAME/YOUR_APP_SHORT_NAME
TELEGRAM_APP_URL=https://t.me/your_bot/your_app

# PostgreSQL connection string — injected automatically by Vercel's Neon integration.
# For local development, point to your own Neon or PostgreSQL instance.
POSTGRES_URL=postgresql://user:password@host/dbname

# After deploying to Vercel, initialize the database schema by visiting:
# GET https://your-project.vercel.app/api/init-db
#
# Then register the bot webhook by visiting:
# curl -X POST https://your-project.vercel.app/api/bot/setup-webhook -H "x-bot-token: YOUR_BOT_TOKEN"

# Receipt scanning (optional). Without these the Add Expense form still works; the receipt
# photo picker just reports that scanning/storage isn't set up.
#
# Google Gemini API key for reading receipts: https://aistudio.google.com/apikey
# Use a different key per environment (staging / production).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override. Default is the "gemini-flash-latest" alias, which tracks the current
# Flash model; pinned names (e.g. gemini-2.5-flash) get retired for new keys and then return 404.
# GEMINI_RECEIPT_MODEL=gemini-flash-latest
#
# Receipt images are stored in a PRIVATE Vercel Blob store. In Vercel: Storage -> Create -> Blob
# (access: Private), then connect it to this project for Production and Preview. That adds
# BLOB_READ_WRITE_TOKEN automatically. One store is shared: production deployments write under
# `production/`, everything else (preview/staging/local) under `staging/`.
# For local dev: `vercel env pull`.
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token
